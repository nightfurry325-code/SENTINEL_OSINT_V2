# ═══════════════════════════════════════════════════════════════
#   SENTINEL OSINT v2.0.0 — Environment Configuration
#   Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Optional API Keys (greatly improve results) ──────────────

# HaveIBeenPwned — breach checking
# Get free key: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# IPInfo — geolocation (free tier: 50k/month)
# Get token: https://ipinfo.io/account/token
IPINFO_TOKEN=

# NumVerify — phone validation (free tier: 100/month)
# Get key: https://numverify.com/product
NUMVERIFY_KEY=

# ── Telegram Bot ─────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── Scan Settings ────────────────────────────────────────────
SENTINEL_TIMEOUT=10
SENTINEL_MAX_WORKERS=20
SENTINEL_DELAY_BETWEEN=0.3

# ── Proxy (optional) ────────────────────────────────────────
# HTTP_PROXY=http://127.0.0.1:8080
# HTTPS_PROXY=http://127.0.0.1:8080
